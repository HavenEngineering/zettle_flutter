{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "zettle_flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "zettle_flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "zettle_flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "example",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "env": {
                "GITHUB_TOKEN": "{Your GitHub Personal Access Token here}",
                "ZETTLE_APP_ID": "com.bourne.teams.debug",
                "ZETTLE_REDIRECT_SCHEME": "teams-debug-app",
                "ZETTLE_REDIRECT_HOST": "login"
            },
            "args": [
                "--dart-define=ZETTLE_IOS_CLIENT_ID=0e8d6277-a459-47af-93f3-3dfbae7c9d6b",
                "--dart-define=ZETTLE_ANDROID_CLIENT_ID=0e8d6277-a459-47af-93f3-3dfbae7c9d6b",
                "--dart-define=ZETTLE_REDIRECT_URL=teams-debug-app://login"
            ]
        },
    ]
}